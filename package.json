{
  "name": "eoss-event-management",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier . --write",
    "email": "email dev --dir features/email",
    "env:hosted": "printf '# GENERIERT von: npm run env:hosted\\n# Nicht hier editieren, sondern in .env.hosted\\n\\n' > .env.local && cat .env.hosted >> .env.local && npm run -s env:show",
    "env:local": "printf '# GENERIERT von: npm run env:local\\n# Nicht hier editieren, sondern in .env.localstack\\n\\n' > .env.local && cat .env.localstack >> .env.local && npm run -s env:show",
    "env:show": "grep -m1 NEXT_PUBLIC_SUPABASE_URL .env.local || echo 'keine .env.local vorhanden'",
    "db:start": "set -a && . ./.env.supabase && set +a && supabase start",
    "db:stop": "supabase stop",
    "db:reset": "set -a && . ./.env.supabase && set +a && supabase db reset --local",
    "db:new": "supabase migration new",
    "db:check": "supabase migration list",
    "db:push": "supabase db push --linked",
    "db:types": "supabase gen types typescript --local > types/database.ts.tmp && mv types/database.ts.tmp types/database.ts",
    "db:types:hosted": "supabase gen types typescript --linked > types/database.ts.tmp && mv types/database.ts.tmp types/database.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@react-email/markdown": "^0.0.18",
    "@supabase/ssr": "^0.12.5",
    "@supabase/supabase-js": "^2.115.0",
    "@t3-oss/env-nextjs": "^0.13.11",
    "@tanstack/react-table": "^8.21.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.2.5",
    "lucide-react": "^0.545.0",
    "next": "16.3.4",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.66.1",
    "resend": "^6.26.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@trivago/prettier-plugin-sort-imports": "^5.2.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-check-file": "^3.3.2",
    "eslint-plugin-n": "^17.23.1",
    "jiti": "^2.6.1",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "react-email": "^6.9.3",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5"
  }
}
